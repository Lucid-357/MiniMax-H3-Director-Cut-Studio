# AI Design connection settings (API keys are never stored here)
# Resolved 2026-09-12. Provider stays lm_studio -> our own Ollama. The OpenAI keys below
# are upstream defaults and are INERT without a key; do NOT supply one. House rule: GPT
# goes through the Codex CLI on the ChatGPT subscription, never a billed API.
H3_DESIGN_PROVIDER="lm_studio"
H3_DESIGN_OPENAI_BASE_URL="https://api.openai.com/v1"
H3_DESIGN_OPENAI_MODEL="gpt-5.6-sol"
H3_DESIGN_LM_STUDIO_BASE_URL="http://mm-homelab:11434/v1"
H3_DESIGN_LM_STUDIO_MODEL="qwen3.8-27b-uncensored:Q3_K_P"
H3_DESIGN_TIMEOUT=900
H3_DESIGN_AUTO_SEMANTIC_ENRICHMENT=false
# TRUE here: the planner and the render share one 16 GB card, so the LLM must let go.
H3_DESIGN_UNLOAD_LM_AFTER_SEMANTIC_ENRICHMENT=true
H3_DESIGN_DIALOGUE_LANGUAGE="English"
H3_DESIGN_SUBTITLES_ENABLED=false
# OFF: the Z-Image concept-image graph needs z_image_turbo_bf16 + qwen_3_4b, both retired
# off this box. Reference images come from hl-img or the Codex image lane and are imported
# into the Media Pool by hand.
H3_DESIGN_GENERATE_COMFY_IMAGES=false
H3_DESIGN_IMAGE_CHECKPOINT="z_image_turbo_bf16.safetensors"
H3_DESIGN_IMAGE_WIDTH=1088
H3_DESIGN_IMAGE_HEIGHT=576
H3_DESIGN_IMAGE_STEPS=8
H3_DESIGN_IMAGE_CFG=1.0
H3_DESIGN_IMAGE_NEGATIVE_PROMPT="low quality, blurry, distorted hands, extra fingers, duplicate person, deformed anatomy, unreadable label, watermark, text artifacts"
