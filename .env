# MiniMax H3 Director settings
# Resolved 2026-09-12 on the merge of upstream main into linux-port.
# Upstream ships this file with its header comment repeated ~250 times (their writer
# appends it on every save) and with the author LAN addresses. Both dropped.
H3_COMFYUI_URL=http://mm-homelab:8188
H3_ASPECT_RATIO=16:9
H3_MEGAPIXELS=1.0
H3_SAMPLING_STEPS=8
H3_DENOISE=1.0
# OFF: Nvidia_RTX_Nodes_ComfyUI is not installed here, and the finish standard is
# realesr-general-x4v3 in the calling repo, not an in-graph RTX upscale.
H3_RTX_VIDEO_SUPER_RESOLUTION=false
H3_HISTORY_POLL_INTERVAL=1.0
H3_GENERATION_TIMEOUT=1800
H3_HTTP_REQUEST_TIMEOUT=30
H3_CONNECTION_RECOVERY_TIMEOUT=3600
H3_DIALOGUE_TTS_ENGINE=h3_native
H3_MUSIC_MODE=auto
H3_BLIP_DEVICE=auto
H3_WORKSPACE_FREE_DISK_RESERVE_GB=50.0
